# --- Slack app (Socket Mode) ---
# Bot User OAuth Token, starts with xoxb-
SLACK_BOT_TOKEN=xoxb-your-bot-token
# App-Level Token with connections:write scope, starts with xapp-
SLACK_APP_TOKEN=xapp-your-app-token
# Signing secret, from Basic Information > App Credentials (used for request verification)
SLACK_SIGNING_SECRET=your-signing-secret

# --- Replicate ---
REPLICATE_API_TOKEN=r8_your-replicate-token

# Your Replicate username, used as the namespace for the destination LoRA model
REPLICATE_USERNAME=your-replicate-username
# Name of the destination model that will hold your trained LoRA version
# (created automatically by scripts/train-lora.js if it doesn't exist yet)
LORA_MODEL_NAME=down-memory-lane-lora

# Trigger word baked into every training caption; every generation prompt
# must include this word so the fine-tuned identity gets invoked
LORA_TRIGGER_WORD=TOK

# Set this after training finishes — scripts/train-lora.js prints it when the
# training job completes. Format: owner/model:version-id
LORA_MODEL_VERSION=
